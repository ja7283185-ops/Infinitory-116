{
  "schemaVersion": 1,
  "id": "infinitory",
  "version": "${version}",

  "name": "Infinitory (1.16.5 Port)",
  "description": "Infinite inventory and stack size! Community port of Furgl's Infinitory mod to Minecraft 1.16.5.",
  "authors": [
    "Furgl (original mod, 1.17.1)",
    "1.16.5 port"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/infinitory",
    "sources": "https://github.com/Furgl/Infinitory"
  },

  "license": "MIT",
  "icon": "assets/infinitory/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "furgl.infinitory.Infinitory"
    ],
    "client": [
      "furgl.infinitory.InfinitoryClient"
    ]
  },
  "mixins": [
    "infinitory.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.11.0",
    "fabric": "*",
    "minecraft": "1.16.x",
    "java": ">=8"
  }
}
